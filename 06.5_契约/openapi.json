        ],
        "title": "CaseBatchIn"
      },
      "DatasetCreate": {
        "properties": {
          "project_id": {
            "type": "integer",
            "title": "Project Id",
            "default": 1
          },
          "name": {
            "type": "string",
            "maxLength": 64,
            "title": "Name"
          },
          "description": {
            "type": "string",
            "title": "Description",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "name"
