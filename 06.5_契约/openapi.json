            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PromptCreate": {
        "properties": {
          "project_id": {
            "type": "integer",
            "title": "Project Id",
            "default": 1
          },
          "name": {
            "type": "string",
            "maxLength": 64,
            "title": "Name"
          },
          "version": {
            "type": "string",
            "maxLength": 32,
            "title": "Version"
          },
          "content": {
            "type": "string",
            "maxLength": 100000,
            "title": "Content"
          },
          "description": {
            "type": "string",
            "title": "Description",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "name",
          "version",
          "content"
        ],
        "title": "PromptCreate"
      },
      "RunCreate": {
        "properties": {
          "dataset_id": {
            "type": "integer",
            "title": "Dataset Id"
          },
          "prompt_a_id": {
            "type": "integer",
            "title": "Prompt A Id"
          },
          "prompt_b_id": {
            "type": "integer",
            "title": "Prompt B Id"
          }
        },
        "type": "object",
        "required": [
          "dataset_id",
          "prompt_a_id",
          "prompt_b_id"
        ],
        "title": "RunCreate"
      },
      "TraceRecordIn": {
        "properties": {
          "trace_id": {
            "type": "string",
            "title": "Trace Id"
          },
          "project_id": {
            "type": "integer",
            "title": "Project Id",
            "default": 1
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "prompt_text": {
            "type": "string",
            "maxLength": 100000,
            "title": "Prompt Text"
          },
          "output_text": {
            "type": "string",
            "maxLength": 100000,
            "title": "Output Text"
          },
          "prompt_tokens": {
            "type": "integer",
            "title": "Prompt Tokens",
            "default": 0
          },
          "completion_tokens": {
            "type": "integer",
            "title": "Completion Tokens",
            "default": 0
          },
          "cost_usd": {
            "type": "number",
            "title": "Cost Usd",
            "default": 0.0
          },
          "latency_ms": {
            "type": "integer",
            "title": "Latency Ms",
            "default": 0
          },
          "source": {
            "type": "string",
            "title": "Source",
            "default": "openai"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "default": "success"
          },
          "error_message": {
            "type": "string",
            "title": "Error Message",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "trace_id",
          "model",
          "prompt_text",
          "output_text"
        ],
        "title": "TraceRecordIn"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
