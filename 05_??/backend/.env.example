# 应用配置
APP_HOST=0.0.0.0
APP_PORT=8086
APP_ENV=dev

# MySQL（共用 3310）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3310
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DB=eoe

# ClickHouse（本项目容器）
CLICKHOUSE_HOST=127.0.0.1
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Redis（共用 6381）
REDIS_HOST=127.0.0.1
REDIS_PORT=6381
REDIS_DB=3

# SDK 上报鉴权（MVP 单 key）
SDK_API_KEY=dev-sdk-key-change-me

# LLM API（评测用，不配则走 mock）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat
